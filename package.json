{
  "name": "repro",
  "version": "0.12.5",
  "private": true,
  "type": "module",
  "description": "Local Chrome evidence capture for agents",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node src/setup.js",
    "start": "node src/server.js",
    "mcp": "node src/mcp.js",
    "capture": "node src/cli.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "install:local": "node src/manage.js install",
    "uninstall:local": "node src/manage.js uninstall",
    "service:status": "node src/manage.js status",
    "service:restart": "node src/manage.js restart"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "license": "MIT"
}
